with "bedrock";

library project Portal is

   type Port_Kind is ("null", "x11", "win32");
   Port : Port_Kind := external ("PORTAL_PORT", "null");
   --  Which body of Portal.Backend to build. "null" needs no display
   --  and is what CI uses. "x11" needs libX11 (apt: libx11-dev).
   --  "win32" needs nothing beyond GNAT on Windows.

   for Library_Name use "portal";
   for Library_Version use "0.1.0";
   for Library_Kind use "static";

   for Source_Dirs use ("src", "ports/" & Port);
   for Object_Dir use "obj/" & Port;
   for Library_Dir use "lib/" & Port;
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-gnata",           --  Pre/Post checked at runtime
         "-gnatwa", "-gnatwe", "-gnatVa",
         "-gnatyg", "-gnatyM100", "-g", "-O2", "-fstack-check");
      for Local_Configuration_Pragmas use "policy.adc";
   end Compiler;

   package Linker is
      case Port is
         when "x11"   => for Linker_Options use ("-lX11");
         when "win32" => for Linker_Options use ("-luser32", "-lgdi32");
         when others  => null;
      end case;
   end Linker;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=1", "-j0");
   end Prove;

end Portal;
